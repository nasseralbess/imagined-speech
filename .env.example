# Copy this file to `.env` and fill in your Emotiv Cortex credentials.
# `.env` is git-ignored. Used by acquisition/server.py.
CLIENT_ID=your-emotiv-client-id
CLIENT_SECRET=your-emotiv-client-secret

# Optional: where the Cortex API exports recorded CSVs.
# Defaults to the repo's data/raw/ directory if unset.
# EXPORT_FOLDER=/absolute/path/to/imagined-speech/data/raw
